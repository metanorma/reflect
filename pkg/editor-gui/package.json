{
  "name": "editor-gui",
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "compile": "tsc --outdir compiled",
    "e2e": "playwright test --config=e2e/playwright.config.ts --project=chromium",
    "e2e:all": "playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui --project=chromium",
    "e2e:install": "playwright install chromium",
    "e2e:install:firefox": "playwright install firefox",
    "e2e:install-all": "playwright install chromium firefox",
    "e2e:install-deps": "playwright install-deps chromium firefox"
  },
  "dependencies": {
    "@metanorma/editor-commands": "workspace:^",
    "@metanorma/file-format": "workspace:^",
    "@metanorma/panel-layout": "workspace:^",
    "@metanorma/prosemirror-editor": "workspace:^",
    "@metanorma/prosemirror-minimap": "workspace:^",
    "@metanorma/relaton": "workspace:^",
    "@metanorma/toolbar": "workspace:^",
    "browser-fs-access": "^0.38.0",
    "dockview": "7.0.4",
    "dockview-core": "7.0.4",
    "dockview-react": "7.0.4",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.25.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "~6.0.3"
  }
}
