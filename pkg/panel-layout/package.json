{
  "name": "@metanorma/panel-layout",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./mock": "./mock/editor-dockview7-floats.html"
  },
  "scripts": {
    "compile": "tsc --outdir compiled",
    "pretest": "yarn compile",
    "test": "yarn node --import ./test-register.mjs --test \"tests/*.test.mjs\"",
    "imports:check": "node ../../scripts/check-imports.mjs .",
    "build": "yarn imports:check && yarn node ../../build-panel-layout.mjs",
    "build:dev": "yarn node ../../build-panel-layout.mjs --dev",
    "tokens:extract": "node mock/extract-design-tokens.mjs && node extract-css.mjs",
    "tokens:check": "node mock/extract-design-tokens.mjs --check && node extract-css.mjs --check",
    "capture:states": "node mock/states/capture.mjs",
    "capture:goldens": "node mock/goldens/capture-goldens.mjs",
    "parity": "playwright test --config=tests/parity/playwright.config.ts",
    "parity:install": "playwright install chromium",
    "parity:install-deps": "playwright install-deps chromium"
  },
  "peerDependencies": {
    "dockview": "7.0.4",
    "dockview-core": "7.0.4",
    "dockview-react": "7.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dockview": "7.0.4",
    "dockview-core": "7.0.4",
    "dockview-react": "7.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.3"
  }
}
