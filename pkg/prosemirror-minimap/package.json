      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.25.8",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "1.42.0",
